                            <span>Chat WA Admin</span>
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-5">
                    <div class="relative mx-auto max-w-md lg:max-w-none">
                        <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-rose-600 to-amber-600 opacity-30 blur-xl"></div>
                        <div class="relative bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl space-y-5">
                            <div class="flex items-center justify-between pb-4 border-b border-slate-800">
