                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Nomor WhatsApp</label>
                        <input type="tel" id="form-phone" required placeholder="0812xxxxxxxx" class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-4 py-3 rounded-xl text-sm focus:outline-none focus:border-rose-500">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Metode Pembayaran (Cash / Angsuran / Transfer)</label>
                    <select id="form-payment" required class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-4 py-3 rounded-xl text-sm focus:outline-none focus:border-rose-500">
                        <option value="">-- Pilih Metode Pembayaran --</option>
                        <optgroup label="E-Wallet & Angsuran PayLater">
                            <option value="DANA (Cash / Angsuran DANA Cicil)">DANA (Cash / Angsuran DANA Cicil)</option>
                            <option value="OVO (Cash / OVO PayLater)">OVO (Cash / OVO PayLater)</option>
                            <option value="GoPay (Cash / GoPayLater Cicil)">GoPay (Cash / GoPayLater Cicil)</option>
                            <option value="ShopeePay (Cash / SPayLater)">ShopeePay (Cash / SPayLater)</option>
                        </optgroup>
                        <optgroup label="Transfer Bank Resmi">
                            <option value="Transfer BCA (Bank Central Asia)">Transfer BCA (Bank Central Asia)</option>
                            <option value="Transfer BSI (Bank Syariah Indonesia)">Transfer BSI (Bank Syariah Indonesia)</option>
                            <option value="Transfer BM (Bank Mandiri)">Transfer BM (Bank Mandiri)</option>
                            <option value="Transfer BNI / BRI">Transfer BNI / BRI</option>
                        </optgroup>
                    </select>
