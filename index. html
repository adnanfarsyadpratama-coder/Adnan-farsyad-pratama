                                <span class="text-xs font-mono text-slate-400">Wild_Nana_Official_System</span>
                            </div>
                            <div class="space-y-3.5">
                                <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <div class="bg-emerald-500/10 text-emerald-400 p-3 rounded-xl">
                                            <i class="fa-solid fa-wallet text-xl"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-slate-400 font-medium">E-Wallet & Angsuran</p>
                                            <p class="text-sm font-bold text-white">DANA / OVO / GoPay / ShopeePay</p>
                                        </div>
                                    </div>
                                    <span class="bg-emerald-500/20 text-emerald-400 text-xs px-2.5 py-1 rounded-full font-semibold">Aktif</span>
                                </div>
                                <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <div class="bg-rose-500/10 text-rose-400 p-3 rounded-xl">
                                            <i class="fa-solid fa-building-columns text-xl"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-slate-400 font-medium">Transfer Bank</p>
                                            <p class="text-sm font-bold text-white">BCA / BSI / Bank Mandiri (BM)</p>
                                        </div>
                                    </div>
                                    <span class="bg-rose-500/20 text-rose-400 text-xs px-2.5 py-1 rounded-full font-semibold">Resmi</span>
                                </div>
                                <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <div class="bg-amber-500/10 text-amber-400 p-3 rounded-xl">
                                            <i class="fa-brands fa-whatsapp text-xl"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs text-slate-400 font-medium">Layanan WA Instant</p>
                                            <p class="text-sm font-bold text-white">0812-3456-7890</p>
                                        </div>
                                    </div>
                                    <span class="bg-amber-500/20 text-amber-400 text-xs px-2.5 py-1 rounded-full font-semibold">Online</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Catalog Section with Table & Grid View -->
    <section id="katalog" class="py-20 bg-slate-950 border-t border-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 space-y-4 md:space-y-0">
                <div>
                    <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Inventory Wild Nana</span>
                    <h2 class="text-3xl font-black text-white mt-1">Katalog Sepatu Branded & Stok Real-Time</h2>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <input type="text" id="search-input" placeholder="Cari model, merk, spesifikasi..." class="bg-slate-900 border border-slate-800 text-slate-200 placeholder-slate-500 px-4 py-2.5 rounded-xl text-sm focus:outline-none focus:border-rose-500 w-full sm:w-64">
                    <div class="flex bg-slate-900 border border-slate-800 p-1 rounded-xl">
                        <button onclick="switchView('grid')" id="btn-grid" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-rose-600 text-white transition-all">Grid</button>
                        <button onclick="switchView('table')" id="btn-table" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition-all">Tabel Lengkap</button>
                    </div>
                </div>
            </div>

            <!-- Brand Filters -->
            <div class="flex flex-wrap gap-2 mb-8" id="brand-filters">
                <button onclick="filterBrand('all')" class="brand-btn active-filter px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 text-white transition-all">Semua Brand</button>
                <button onclick="filterBrand('Nike')" class="brand-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-all">Nike</button>
                <button onclick="filterBrand('Adidas')" class="brand-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-all">Adidas</button>
                <button onclick="filterBrand('New Balance')" class="brand-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-all">New Balance</button>
                <button onclick="filterBrand('Salomon')" class="brand-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-all">Salomon</button>
                <button onclick="filterBrand('Asics')" class="brand-btn px-4 py-2 rounded-xl text-xs font-bold bg-slate-900 border border-slate-800 text-slate-300 hover:text-white transition-all">Asics</button>
            </div>

            <!-- Grid View -->
            <div id="product-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Javascript dynamic render -->
            </div>

            <!-- Table View -->
            <div id="product-table-view" class="hidden overflow-x-auto bg-slate-900 border border-slate-800 rounded-2xl shadow-xl">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-950 text-slate-400 text-xs font-semibold uppercase tracking-wider border-b border-slate-800">
                            <th class="py-4 px-6">Produk & Model</th>
                            <th class="py-4 px-6">Ukuran (Size)</th>
                            <th class="py-4 px-6">Harga (IDR)</th>
                            <th class="py-4 px-6">Jumlah Stok</th>
                            <th class="py-4 px-6">Spesifikasi Lengkap</th>
                            <th class="py-4 px-6 text-center">Order via WA</th>
                        </tr>
                    </thead>
                    <tbody id="product-table-body" class="divide-y divide-slate-800 text-sm text-slate-300">
                        <!-- Javascript dynamic render -->
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Payment Methods Section -->
    <section id="metode-pembayaran" class="py-20 bg-slate-900/50 border-t border-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Kemudahan Bertransaksi</span>
                <h2 class="text-3xl font-black text-white mt-1">Pembayaran Cash, Angsuran E-Wallet & Transfer Bank</h2>
                <p class="text-slate-400 text-sm mt-2">Wild Nana menyediakan berbagai metode pembayaran aman agar transaksi pembelian sepatu branded idamanmu semakin gampang.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- E-Wallet & Angsuran -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 space-y-6 hover:border-rose-500/50 transition-all">
                    <div class="bg-rose-600/10 text-rose-400 w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-bold">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">Cash & Angsuran E-Wallet</h3>
                        <p class="text-slate-400 text-xs mt-1">Cash Saldo / Angsuran PayLater</p>
                    </div>
                    <ul class="space-y-3 text-sm text-slate-300">
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span><strong>DANA</strong> (Saldo Cash & Angsuran DANA Cicil)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span><strong>OVO</strong> (Cash / OVO PayLater)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span><strong>GoPay</strong> (GoPay Cash & Cicilan GoPayLater)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span>ShopeePay & LinkAja</span>
                        </li>
                    </ul>
                </div>

                <!-- Transfer Bank -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 space-y-6 hover:border-rose-500/50 transition-all">
                    <div class="bg-pink-600/10 text-pink-400 w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-bold">
                        <i class="fa-solid fa-building-columns"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">Transfer Bank Resmi</h3>
                        <p class="text-slate-400 text-xs mt-1">Verifikasi Pembayaran Cepat</p>
                    </div>
                    <ul class="space-y-3 text-sm text-slate-300">
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-pink-400"></i>
                            <span><strong>BCA</strong> (Bank Central Asia)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-pink-400"></i>
                            <span><strong>BSI</strong> (Bank Syariah Indonesia)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-pink-400"></i>
                            <span><strong>BM</strong> (Bank Mandiri)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-pink-400"></i>
                            <span>Bank BNI & BRI</span>
                        </li>
                    </ul>
                </div>

                <!-- Pengiriman Cepat -->
                <div class="bg-slate-900 border border-slate-800 rounded-3xl p-8 space-y-6 hover:border-rose-500/50 transition-all">
                    <div class="bg-emerald-600/10 text-emerald-400 w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-bold">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-bold text-white">Pengiriman Safe Box</h3>
                        <p class="text-slate-400 text-xs mt-1">Jaminan Box Mulus Sampai Rumah</p>
                    </div>
                    <ul class="space-y-3 text-sm text-slate-300">
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span>Double Box + Heavy Bubble Wrap</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span>Ekspedisi JNE, J&T, SiCepat, AnterAja</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span>Instant Courier (GoSend / GrabExpress)</span>
                        </li>
                        <li class="flex items-center space-x-3">
                            <i class="fa-solid fa-circle-check text-emerald-400"></i>
                            <span>Garansi Penukaran Size (S&K Berlaku)</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- Order Modal -->
    <div id="checkout-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-3xl max-w-lg w-full p-6 sm:p-8 relative shadow-2xl space-y-6 max-h-[90vh] overflow-y-auto">
            <button onclick="closeModal()" class="absolute top-6 right-6 text-slate-400 hover:text-white bg-slate-800/50 hover:bg-slate-800 w-10 h-10 rounded-full flex items-center justify-center transition-all">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
            <div>
                <span class="text-rose-400 text-xs font-bold uppercase tracking-widest">Order Form WhatsApp Wild Nana</span>
                <h3 class="text-2xl font-black text-white mt-1">Pemesanan Sepatu</h3>
                <p class="text-slate-400 text-xs mt-1">Pesanan Anda akan langsung dirangkum dan diteruskan ke WhatsApp Official Wild Nana (<strong class="text-white">0812-3456-7890</strong>)</p>
            </div>

            <form id="order-form" onsubmit="submitOrder(event)" class="space-y-4">
                <input type="hidden" id="form-product-name">
                <input type="hidden" id="form-product-price">
                
                <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-400">Model Sepatu:</span>
                        <span id="display-prod-name" class="font-bold text-white text-right"></span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-400">Harga Produk:</span>
                        <span id="display-prod-price" class="font-bold text-emerald-400"></span>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Pilih Ukuran (Size)</label>
                    <select id="form-size" required class="w-full bg-slate-950 border border-slate-800 text-slate-200 px-4 py-3 rounded-xl text-sm focus:outline-none focus:border-rose-500">
                        <option value="">-- Pilih Ukuran --</option>
                    </select>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-slate-300 uppercase mb-2">Nama Pemesan</label>
